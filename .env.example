# Browser-safe Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only secret key required for optional username/password login, registration, and guest carry-over (never expose as NEXT_PUBLIC_*).
SUPABASE_SERVICE_ROLE_KEY=
# Optional public Cloudflare Turnstile site key; configure the matching secret only in Supabase Auth.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
