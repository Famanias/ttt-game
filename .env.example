# Browser-safe Supabase project settings. No service-role key is needed.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional public Cloudflare Turnstile site key; configure the matching secret only in Supabase Auth.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
